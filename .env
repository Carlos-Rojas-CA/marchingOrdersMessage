# Committed on purpose.
#
# An OAuth client id is not a secret — it ships inside the JavaScript bundle of
# every browser-based OAuth app, so anyone who opens the site can read it.
# Hiding it would buy nothing and would mean `npm run dev` needed setup on
# every machine.
#
# What actually protects the app is the "Authorized JavaScript origins" list on
# this client in Google Cloud Console: a request carrying this id from an
# unregistered origin is refused. Keep that list tight.
#
# There is no client secret anywhere in this project. The browser uses PKCE,
# which does not have one. If Google generated a client secret alongside this
# id, leave it unused in the console and never commit it.
#
# Anything genuinely private belongs in .env.local, which is gitignored.

VITE_GOOGLE_CLIENT_ID=496732941941-9lge79lq13lsm0hm16u2k9mtdoui0gg1.apps.googleusercontent.com
